---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { t } from "~/i18n/ui";
import { SITE_URL, withLocale } from "~/i18n/utils";

const locale = "en" as const;
const strings = t(locale);

const all = await getCollection("docs", (e) => e.id.startsWith("en/") && !e.data.draft);

const SECTION_ORDER = [
  "getting-started",
  "daily-use",
  "training",
  "health-signals",
  "privacy",
  "faq",
] as const;

const grouped = new Map<string, CollectionEntry<"docs">[]>();
for (const e of all) {
  if (!grouped.has(e.data.section)) grouped.set(e.data.section, []);
  grouped.get(e.data.section)!.push(e);
}
for (const arr of grouped.values()) arr.sort((a, b) => a.data.order - b.data.order);

function entrySlug(e: CollectionEntry<"docs">) {
  return e.id
    .replace(/^en\//, "")
    .replace(/\.md$/, "")
    .replace(/\/index$/, "");
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Corpus Docs",
  url: SITE_URL + "/en/docs",
  inLanguage: "en-US",
  publisher: { "@type": "Organization", name: "Corpus", url: SITE_URL },
};
---
<BaseLayout
  locale={locale}
  title="Docs — Corpus"
  description={strings.docs.indexIntro}
  jsonLd={jsonLd}
>
  <Section class="pt-12 pb-20">
    <p class="text-xs uppercase tracking-[0.18em] text-accent/90">{strings.docs.indexTitle}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl" style="text-wrap: balance;">
      Get more out of Corpus.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-text-secondary">{strings.docs.indexIntro}</p>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      {SECTION_ORDER.map((s) => {
        const items = grouped.get(s);
        if (!items?.length) return null;
        return (
          <div>
            <p class="mb-3 text-xs uppercase tracking-[0.16em] text-accent/90">{strings.sections[s]}</p>
            <ul class="space-y-3 border-l border-hairline pl-4">
              {items.map((e) => (
                <li>
                  <a href={withLocale(locale, `/docs/${entrySlug(e)}`)} class="group block">
                    <span class="font-medium text-text-primary group-hover:text-accent">{e.data.title}</span>
                    <span class="block text-sm text-text-secondary">{e.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </Section>
</BaseLayout>
