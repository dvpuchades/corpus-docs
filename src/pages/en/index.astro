---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/home/Hero.astro";
import ProblemSolution from "~/components/home/ProblemSolution.astro";
import FeatureGrid from "~/components/home/FeatureGrid.astro";
import LifestyleBand from "~/components/LifestyleBand.astro";
import HowItWorks from "~/components/home/HowItWorks.astro";
import PrivacyCallout from "~/components/home/PrivacyCallout.astro";
import FinalCta from "~/components/home/FinalCta.astro";
import { APP_ID, APP_STORE_URL, CONTACT_EMAIL, SITE_URL } from "~/i18n/utils";

const locale = "en" as const;
const headline = "The coach your Apple Watch was waiting for.";
const subhead =
  "Corpus reads your Apple Health data and turns it into a daily plan tuned to you — sleep, training, recovery, energy. No new hardware. €3.99 a month.";

const lifestyle = [
  { src: "/images/lifestyle/running.jpg", alt: "Runner on a road at dawn" },
  { src: "/images/lifestyle/cycling.jpg", alt: "Cyclist on an open road" },
  { src: "/images/lifestyle/track-runner.jpg", alt: "Athlete on a running track" },
  { src: "/images/lifestyle/swimming.jpg", alt: "Swimmer in open water" },
  { src: "/images/lifestyle/runner.jpg", alt: "Runner mid-stride" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Corpus",
    applicationCategory: "HealthApplication",
    operatingSystem: "iOS 26.4",
    description: subhead,
    url: SITE_URL + "/en/",
    image: SITE_URL + "/og/en.png",
    offers: { "@type": "Offer", price: "3.99", priceCurrency: "EUR" },
    installUrl: APP_STORE_URL,
    sameAs: [APP_STORE_URL],
    softwareVersion: "1.x",
    publisher: {
      "@type": "Organization",
      name: "Corpus",
      url: SITE_URL,
    },
    aggregateRating: undefined,
    identifier: APP_ID,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Corpus",
    url: SITE_URL,
    logo: SITE_URL + "/images/icon/icon-512.png",
    contactPoint: {
      "@type": "ContactPoint",
      email: CONTACT_EMAIL,
      contactType: "customer support",
      availableLanguage: ["en", "es"],
    },
  },
];
---
<BaseLayout
  locale={locale}
  title="Corpus — The coach your Apple Watch was waiting for."
  description={subhead}
  jsonLd={jsonLd}
>
  <Hero
    locale={locale}
    headline={headline}
    subhead={subhead}
    heroImage="/images/screenshots/en/dashboard.PNG"
    heroImageAlt="Corpus dashboard on iPhone showing today's recovery, sleep and strain"
  />
  <ProblemSolution locale={locale} />
  <FeatureGrid locale={locale} />
  <LifestyleBand photos={lifestyle} />
  <HowItWorks locale={locale} />
  <PrivacyCallout locale={locale} />
  <FinalCta locale={locale} />
</BaseLayout>
