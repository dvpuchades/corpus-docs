---
import BaseLayout from "./BaseLayout.astro";
import Section from "~/components/Section.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { t, type Locale } from "~/i18n/ui";
import { absoluteUrl, withLocale, stripLocale, SITE_URL } from "~/i18n/utils";

interface Props {
  entry: CollectionEntry<"docs">;
  locale: Locale;
  headings: { depth: number; slug: string; text: string }[];
}
const { entry, locale, headings } = Astro.props;
const strings = t(locale);

const SECTION_ORDER = [
  "getting-started",
  "daily-use",
  "training",
  "health-signals",
  "privacy",
  "faq",
] as const;

function sectionIndex(s: string) {
  const i = (SECTION_ORDER as readonly string[]).indexOf(s);
  return i === -1 ? 99 : i;
}

const all = await getCollection("docs", (e) => !e.data.draft && e.id.startsWith(`${locale}/`));
all.sort((a, b) => {
  const sa = sectionIndex(a.data.section);
  const sb = sectionIndex(b.data.section);
  if (sa !== sb) return sa - sb;
  return a.data.order - b.data.order;
});

const grouped = new Map<string, CollectionEntry<"docs">[]>();
for (const e of all) {
  const k = e.data.section;
  if (!grouped.has(k)) grouped.set(k, []);
  grouped.get(k)!.push(e);
}

function entrySlug(e: CollectionEntry<"docs">): string {
  return e.id
    .replace(/^[a-z]{2}\//, "")
    .replace(/\.md$/, "")
    .replace(/\/index$/, "");
}

function entryUrl(e: CollectionEntry<"docs">): string {
  return withLocale(locale, `/docs/${entrySlug(e)}`);
}

const currentUrl = entryUrl(entry);

const updatedFmt = entry.data.updated.toLocaleDateString(locale === "es" ? "es-ES" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const articleJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.summary,
  inLanguage: locale === "es" ? "es-ES" : "en-US",
  datePublished: entry.data.updated.toISOString(),
  dateModified: entry.data.updated.toISOString(),
  mainEntityOfPage: absoluteUrl(currentUrl),
  publisher: {
    "@type": "Organization",
    name: "Corpus",
    url: SITE_URL,
    logo: SITE_URL + "/images/icon/icon-512.png",
  },
};

let faqJsonLd: Record<string, unknown> | null = null;
if (entry.data.section === "faq") {
  const body = entry.body ?? "";
  const blocks = body.split(/\n##\s+/).slice(1);
  const items: Record<string, unknown>[] = [];
  for (const b of blocks) {
    const nlIdx = b.indexOf("\n");
    if (nlIdx === -1) continue;
    const q = b.slice(0, nlIdx).trim();
    const rest = b.slice(nlIdx).trim();
    const aRaw = rest.split(/\n##\s+/)[0];
    const answer = aRaw
      .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // markdown links → text
      .replace(/\*\*([^*]+)\*\*/g, "$1")        // bold
      .replace(/\*([^*]+)\*/g, "$1")            // italics
      .replace(/`([^`]+)`/g, "$1")              // inline code
      .replace(/\n+/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    if (!q || !answer) continue;
    items.push({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: answer },
    });
  }
  if (items.length) {
    faqJsonLd = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: items,
    };
  }
}

const ld = faqJsonLd ? [articleJsonLd, faqJsonLd] : articleJsonLd;
---
<BaseLayout
  locale={locale}
  title={`${entry.data.title} — Corpus ${strings.docs.indexTitle}`}
  description={entry.data.summary}
  jsonLd={ld}
>
  <Section class="pt-12 pb-20">
    <nav aria-label="breadcrumb" class="mb-6 text-sm text-text-secondary">
      <a href={withLocale(locale, "/docs")} class="hover:text-text-primary">{strings.docs.indexTitle}</a>
      <span class="mx-2 opacity-50">/</span>
      <span class="text-text-primary">{entry.data.title}</span>
    </nav>

    <div class="grid gap-12 lg:grid-cols-[260px_minmax(0,1fr)_220px]">
      <aside class="lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100dvh-6rem)] lg:overflow-y-auto">
        <a href={withLocale(locale, "/docs")} class="text-sm text-text-secondary hover:text-text-primary inline-flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          {strings.docs.backToDocs}
        </a>

        <div class="mt-6 space-y-6 border-t border-hairline pt-6">
          {SECTION_ORDER.map((s) => {
            const items = grouped.get(s);
            if (!items?.length) return null;
            return (
              <div>
                <p class="mb-2 text-xs uppercase tracking-[0.16em] text-text-secondary">{strings.sections[s]}</p>
                <ul class="space-y-1">
                  {items.map((e) => {
                    const u = entryUrl(e);
                    const isCurrent = u === currentUrl;
                    return (
                      <li>
                        <a
                          href={u}
                          aria-current={isCurrent ? "page" : undefined}
                          class:list={[
                            "block rounded-lg px-2.5 py-1.5 text-sm transition",
                            isCurrent
                              ? "bg-bg-1 text-text-primary"
                              : "text-text-secondary hover:bg-bg-1 hover:text-text-primary",
                          ]}
                        >
                          {e.data.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </div>
      </aside>

      <article class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl" style="text-wrap: balance;">{entry.data.title}</h1>
        <p class="mt-4 max-w-2xl text-lg text-text-secondary leading-relaxed">{entry.data.summary}</p>
        <p class="mt-3 text-xs uppercase tracking-[0.14em] text-text-secondary">
          {strings.docs.lastUpdated} · <time datetime={entry.data.updated.toISOString()}>{updatedFmt}</time>
        </p>

        <hr class="my-8" />

        <div class="prose-corpus">
          <slot />
          <p class="doc-summary"><strong>{strings.docs.summaryLabel}.</strong> {entry.data.summary}</p>
        </div>
      </article>

      <aside class="hidden lg:block lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100dvh-6rem)] lg:overflow-y-auto">
        {filteredHeadings.length > 0 && (
          <>
            <p class="mb-3 text-xs uppercase tracking-[0.16em] text-text-secondary">{strings.docs.onThisPage}</p>
            <ul class="space-y-1.5 border-l border-hairline pl-3 text-sm">
              {filteredHeadings.map((h) => (
                <li class:list={[h.depth === 3 && "pl-3"]}>
                  <a href={`#${h.slug}`} class="text-text-secondary hover:text-text-primary">{h.text}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </aside>
    </div>
  </Section>
</BaseLayout>
