---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { type Locale, t } from "~/i18n/ui";
import { absoluteUrl, alternateLanguageUrls, stripLocale } from "~/i18n/utils";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pathOverride?: string;
}
const {
  locale,
  title,
  description,
  ogImage,
  noIndex = false,
  jsonLd,
  pathOverride,
} = Astro.props;

const strings = t(locale);
const pathname = pathOverride ?? Astro.url.pathname;
const canonical = absoluteUrl(pathname.replace(/\/$/, "") || "/");
const alternates = alternateLanguageUrls(stripLocale(pathname));
const og = ogImage ?? `/og/${locale}.png`;
const ogAbsolute = absoluteUrl(og);
const ldSerialized = jsonLd ? JSON.stringify(jsonLd) : null;
---
<!doctype html>
<html lang={locale} class="bg-bg-base">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbsolute} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbsolute} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/icon/icon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/icon-180.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {ldSerialized && (
      <script type="application/ld+json" is:inline set:html={ldSerialized} />
    )}

    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-bg-2 focus:px-4 focus:py-2 focus:text-text-primary"
    >
      {locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <Header locale={locale} pathname={pathname} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} pathname={pathname} />

    <script>
      // Reveal-on-scroll, respects prefers-reduced-motion
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
