---
import { APP_STORE_URL } from "~/i18n/utils";
import { t, type Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { locale, size = "md", class: className = "" } = Astro.props;
const strings = t(locale);

const sizeClass =
  size === "lg"
    ? "h-16 px-7 text-lg"
    : size === "sm"
      ? "h-11 px-4 text-sm"
      : "h-14 px-6 text-base";
---
<a
  href={APP_STORE_URL}
  rel="noopener"
  aria-label={strings.cta.downloadAlt}
  class={`group inline-flex items-center gap-3 rounded-pill bg-white text-black font-semibold transition hover:scale-[1.02] active:scale-[0.99] ${sizeClass} ${className}`}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="22"
    height="22"
    fill="currentColor"
    class="-ml-1"
  >
    <path d="M16.365 1.43c0 1.14-.41 2.21-1.18 3.04-.86.92-2.27 1.61-3.39 1.52-.13-1.07.39-2.18 1.16-3.03.85-.93 2.31-1.66 3.41-1.53zm4.61 16.18c-.62 1.43-.92 2.07-1.72 3.34-1.11 1.78-2.68 4-4.62 4.02-1.72.02-2.16-1.12-4.49-1.11-2.34.01-2.83 1.13-4.55 1.11-1.94-.02-3.42-2.02-4.53-3.8C-.16 17.32-.5 11.7 1.66 8.78c1.55-2.1 4-3.33 6.32-3.33 2.36 0 3.84 1.3 5.79 1.3 1.89 0 3.04-1.3 5.77-1.3 2.06 0 4.25 1.12 5.81 3.06-5.11 2.8-4.28 10.1.63 12.1z"/>
  </svg>
  <span class="leading-tight flex flex-col -space-y-0.5">
    <span class="text-[0.65em] font-medium opacity-70">{locale === "es" ? "Descargar en el" : "Download on the"}</span>
    <span class="font-semibold tracking-tight">App Store</span>
  </span>
</a>
