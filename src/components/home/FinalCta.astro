---
import Section from "~/components/Section.astro";
import AppStoreBadge from "~/components/AppStoreBadge.astro";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = locale === "es"
  ? {
      title: "Tu cuerpo ya tiene los datos. Ahora también el plan.",
      sub: "3,99 € al mes y funciona con el iPhone y el Apple Watch que ya tienes.",
    }
  : {
      title: "Your body already has the data. Now you have the plan.",
      sub: "€3.99 a month, and it works with the iPhone and Apple Watch you already own.",
    };
---
<Section class="py-24 text-center">
  <h2 class="reveal mx-auto max-w-3xl text-3xl font-semibold tracking-tight sm:text-5xl" style="text-wrap: balance;">
    {copy.title}
  </h2>
  <p class="reveal mx-auto mt-6 max-w-2xl text-lg text-text-secondary">{copy.sub}</p>
  <div class="reveal mt-10 flex justify-center">
    <AppStoreBadge locale={locale} size="lg" />
  </div>
</Section>
