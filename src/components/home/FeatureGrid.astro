---
import Section from "~/components/Section.astro";
import FeatureCard from "~/components/FeatureCard.astro";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

type Card = {
  title: string;
  body: string;
  image?: string;
  alt?: string;
  imagePosition?: "top" | "bottom" | "center";
  icon?: "spark" | "lock" | "heart";
};

const screenshotDir =
  locale === "es" ? "/images/screenshots/es" : "/images/screenshots/en";

const cards: Card[] = locale === "es"
  ? [
      {
        title: "Seis métricas claras y un comentario que cambia con tu cuerpo",
        body: "Sueño, disposición, esfuerzo, estrés, recuperación y pasos — con niveles, no números crípticos. Y un comentario diario del coach que explica qué pasó esta noche.",
        image: `${screenshotDir}/dashboard.PNG`,
        alt: "Pantalla principal de Corpus con el comentario del coach, las seis métricas y las notas del día",
      },
      {
        title: "Tu plan semanal, basado en tu objetivo",
        body: "Un plan por fases que se reorganiza cuando la vida cambia. Cada día tiene su anillo: sueño, trabajo, hueco disponible y entrenamiento.",
        image: `${screenshotDir}/roadmap.PNG`,
        alt: "Roadmap semanal en Corpus con anillos diarios para cada día",
      },
      {
        title: "Insights personalizados de tus hábitos",
        body: "Tras dos o tres semanas, Corpus encuentra los patrones reales en tus datos: qué afecta a tu sueño, a tu recuperación, a tu energía.",
        image: `${screenshotDir}/insight.PNG`,
        alt: "Insight de sueño en Corpus mostrando patrones personalizados",
      },
      {
        title: "Pídele al coach que cambie tu plan",
        body: "El chat puede mover entrenamientos, ajustar la intensidad, replanificar tu semana o actualizar el objetivo. Sin salir de la conversación.",
        image: `${screenshotDir}/chat.PNG`,
        alt: "Pantalla del chat de Corpus con sugerencias para preguntar al coach",
        imagePosition: "bottom",
      },
      {
        title: "Hecho para Apple Salud",
        body: "Lee lo que tu iPhone y tu Apple Watch ya registran. Funciona con básculas inteligentes, datos del ciclo y sesiones de mindfulness.",
        icon: "heart",
      },
      {
        title: "On-device, privado por diseño",
        body: "Tu iPhone es el único sitio donde viven tus datos. El coach pide lo que necesita bajo demanda y nada se guarda en servidor.",
        icon: "lock",
      },
    ]
  : [
      {
        title: "Six clear metrics and a coach who reads them for you",
        body: "Sleep, readiness, strain, stress, recovery and steps — with levels, not cryptic numbers. Plus a daily coaching comment that explains what last night actually meant.",
        image: `${screenshotDir}/dashboard.PNG`,
        alt: "Corpus dashboard showing the coach's daily comment, six metric tiles, and today's notes",
      },
      {
        title: "Goals and a weekly roadmap that adapts",
        body: "A periodized week shaped to your goal that reshuffles when life intervenes. Every day has its ring: sleep, work, free hours, training.",
        image: `${screenshotDir}/week.PNG`,
        alt: "Weekly view in Corpus with day rings for each day of the week",
      },
      {
        title: "Workout detail with an AI insight",
        body: "Heart-rate zones, splits, route — and a session-specific paragraph about what your effort meant for your goal and what to do next.",
        image: `${screenshotDir}/swimming.PNG`,
        alt: "Workout detail in Corpus with an AI-generated insight about a swim session",
      },
      {
        title: "Ask the coach to change your plan",
        body: "The chat can move sessions, swap intensity, re-plan the week, or update your goal — straight from the conversation. No buttons, no menus.",
        image: `${screenshotDir}/plan-chat.jpeg`,
        alt: "Chat screen in Corpus with the user about to ask the coach to plan the week",
        imagePosition: "bottom",
      },
      {
        title: "Built for Apple Health",
        body: "Reads what your iPhone and Apple Watch already track. Works with smart scales, cycle data and mindfulness sessions.",
        icon: "heart",
      },
      {
        title: "On-device, private by design",
        body: "Your iPhone is the only place your data lives. The coach pulls what it needs on demand and nothing is stored on a server.",
        icon: "lock",
      },
    ];

const eyebrow = locale === "es" ? "Qué hace Corpus" : "What Corpus does";
const title = locale === "es"
  ? "Tu cuerpo, traducido a métricas claras y un plan que reacciona."
  : "Your body, translated into clear metrics and a plan that reacts.";
---
<Section class="py-20">
  <p class="reveal text-xs uppercase tracking-[0.18em] text-accent/90">{eyebrow}</p>
  <h2 class="reveal mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl" style="text-wrap: balance;">
    {title}
  </h2>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map((c) => (
      <FeatureCard
        title={c.title}
        body={c.body}
        image={c.image}
        imageAlt={c.alt}
        imagePosition={c.imagePosition}
        icon={c.icon}
      />
    ))}
  </div>
</Section>
