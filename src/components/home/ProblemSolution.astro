---
import Section from "~/components/Section.astro";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = locale === "es"
  ? {
      eyebrow: "Donde encajamos",
      title: "Datos sin entrenamiento, o entrenamiento sin tus datos. Hasta ahora.",
      apple: {
        title: "Apple Fitness y Salud",
        body: "Te dan los números, pero no el plan. Frecuencia cardíaca, sueño, esfuerzo… te toca a ti decidir qué significa.",
      },
      whoop: {
        title: "Whoop, Oura, Garmin Coach",
        body: "Buen entrenamiento, pero pulsera o anillo extra y 30 €/mes. Otra cuenta, otro cargador, otra recarga.",
      },
      corpus: {
        title: "Corpus",
        body: "Lee tus datos de Apple Salud y los convierte en un plan diario hecho a tu medida. Sin hardware nuevo. 3,99 €/mes — lo que cuesta un café.",
      },
    }
  : {
      eyebrow: "Where we fit",
      title: "Data without coaching, or coaching without your data. Until now.",
      apple: {
        title: "Apple Fitness & Health",
        body: "You get the numbers, not the plan. Heart rate, sleep, strain — what to do with all of it is on you.",
      },
      whoop: {
        title: "Whoop, Oura, Garmin Coach",
        body: "Good coaching, but a strap or ring on top of your watch and €30/month. Another account, another charger, another thing to wear.",
      },
      corpus: {
        title: "Corpus",
        body: "Reads your Apple Health data and turns it into a daily plan tuned to you. No new hardware. €3.99/month — the price of a coffee.",
      },
    };
---
<Section class="py-20">
  <p class="reveal text-xs uppercase tracking-[0.18em] text-accent/90">{copy.eyebrow}</p>
  <h2 class="reveal mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl" style="text-wrap: balance;">
    {copy.title}
  </h2>

  <div class="mt-12 grid gap-4 md:grid-cols-3">
    <article class="reveal rounded-card border border-hairline/70 bg-bg-1 p-6">
      <h3 class="text-base font-semibold text-text-primary">{copy.apple.title}</h3>
      <p class="mt-3 text-text-secondary leading-relaxed">{copy.apple.body}</p>
    </article>

    <article class="reveal rounded-card border border-hairline/70 bg-bg-1 p-6">
      <h3 class="text-base font-semibold text-text-primary">{copy.whoop.title}</h3>
      <p class="mt-3 text-text-secondary leading-relaxed">{copy.whoop.body}</p>
    </article>

    <article class="reveal rounded-card border border-accent/50 bg-[#26262a] p-6 ring-1 ring-accent/30 shadow-[0_0_40px_-12px] shadow-accent/30">
      <h3 class="text-base font-semibold text-text-primary">{copy.corpus.title}</h3>
      <p class="mt-3 text-text-primary leading-relaxed">{copy.corpus.body}</p>
    </article>
  </div>
</Section>
