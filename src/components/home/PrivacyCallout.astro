---
import Section from "~/components/Section.astro";
import { withLocale } from "~/i18n/utils";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = locale === "es"
  ? {
      eyebrow: "Privacidad",
      title: "Tu dispositivo es el único sitio donde viven tus datos.",
      body: "Nada se guarda en servidor. Cuando el coach necesita datos para responder, los pide bajo demanda y se descartan tras la respuesta. Sin cuentas, sin redes, sin analíticas de terceros.",
      cta: "Lee la política de privacidad",
    }
  : {
      eyebrow: "Privacy",
      title: "Your device is the only place your data lives.",
      body: "Nothing is stored on a server. When the coach needs data to answer, it's pulled on demand and discarded after the response. No accounts, no social, no third-party analytics.",
      cta: "Read the privacy policy",
    };
---
<Section class="py-16">
  <div class="reveal rounded-card border border-hairline/70 bg-gradient-to-br from-bg-1 to-bg-2 p-8 sm:p-12">
    <p class="text-xs uppercase tracking-[0.18em] text-accent/90">{copy.eyebrow}</p>
    <h2 class="mt-3 max-w-3xl text-2xl font-semibold tracking-tight sm:text-3xl" style="text-wrap: balance;">
      {copy.title}
    </h2>
    <p class="mt-4 max-w-2xl text-text-secondary leading-relaxed">{copy.body}</p>
    <a
      href={withLocale(locale, "/privacy")}
      class="mt-6 inline-flex items-center gap-2 rounded-pill border border-hairline px-5 py-2.5 text-sm font-medium text-text-primary transition hover:border-accent hover:text-accent"
    >
      {copy.cta}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</Section>
