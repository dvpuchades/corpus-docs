---
import Section from "~/components/Section.astro";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const copy = locale === "es"
  ? {
      eyebrow: "Cómo funciona",
      title: "Tres pasos. Diez minutos. Sin hardware extra.",
      steps: [
        {
          n: "01",
          title: "Conecta Apple Salud",
          body: "Corpus pide los permisos de Salud que necesita y te explica para qué sirve cada uno. Tus datos siguen en tu iPhone.",
        },
        {
          n: "02",
          title: "Marca un objetivo",
          body: "Una maratón en otoño, dormir mejor, perder grasa, recomponer… o simplemente entender tu cuerpo. El plan se ajusta solo.",
        },
        {
          n: "03",
          title: "Recibe tu plan diario",
          body: "Cada mañana: un comentario del entrenador, tu nivel de recuperación y la sesión del día. Cambia tu agenda y el plan se reorganiza.",
        },
      ],
    }
  : {
      eyebrow: "How it works",
      title: "Three steps. Ten minutes. No extra hardware.",
      steps: [
        {
          n: "01",
          title: "Connect Apple Health",
          body: "Corpus asks only for the Health permissions it needs and explains exactly what each one is for. Your data stays on your iPhone.",
        },
        {
          n: "02",
          title: "Set a goal",
          body: "A marathon in the autumn, sleeping better, losing fat, recomposition — or simply understanding your body. The plan adapts.",
        },
        {
          n: "03",
          title: "Get a daily plan",
          body: "Every morning: your coach's comment, your recovery state, and today's session. Change your week and the plan reshuffles.",
        },
      ],
    };
---
<Section class="py-20">
  <p class="reveal text-xs uppercase tracking-[0.18em] text-accent/90">{copy.eyebrow}</p>
  <h2 class="reveal mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl" style="text-wrap: balance;">
    {copy.title}
  </h2>

  <ol class="mt-12 grid gap-4 md:grid-cols-3">
    {copy.steps.map((s) => (
      <li class="reveal rounded-card border border-hairline/70 bg-bg-1 p-6">
        <span class="font-mono text-sm text-accent">{s.n}</span>
        <h3 class="mt-3 text-lg font-semibold text-text-primary">{s.title}</h3>
        <p class="mt-2 text-text-secondary leading-relaxed">{s.body}</p>
      </li>
    ))}
  </ol>
</Section>
