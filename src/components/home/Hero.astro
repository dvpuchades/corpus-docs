---
import Section from "~/components/Section.astro";
import DeviceFrame from "~/components/DeviceFrame.astro";
import { APP_STORE_URL } from "~/i18n/utils";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
  headline: string;
  subhead: string;
  heroImage: string;
  heroImageAlt: string;
}
const { locale, headline, subhead, heroImage, heroImageAlt } = Astro.props;

const ctaCopy = locale === "es"
  ? {
      primary: "Empieza tu semana gratis",
      ariaLabel: "Empieza tu prueba gratuita de 7 días en el App Store",
      secondary: "Después, 3,99 €/mes — por lo que cuesta un café y una tostada.",
    }
  : {
      primary: "Start your free week",
      ariaLabel: "Start your free 7-day trial on the App Store",
      secondary: "Then €3.99/month — the price of a coffee in Ireland.",
    };
---
<Section as="section" class="pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-16 relative overflow-hidden">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[520px] w-[820px] -translate-x-1/2 rounded-full bg-accent/15 blur-[120px]" />
    <div class="absolute right-[-10%] top-1/3 h-[420px] w-[640px] rounded-full bg-success/[0.06] blur-[120px]" />
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="reveal flex items-center gap-3">
        <img
          src="/images/icon/icon-64.png"
          srcset="/images/icon/icon-64.png 1x, /images/icon/icon-128.png 2x"
          width="56"
          height="56"
          alt="Corpus"
          class="rounded-[14px] ring-1 ring-hairline"
        />
        <span class="rounded-pill bg-bg-1 px-3 py-1 text-xs uppercase tracking-[0.16em] text-text-secondary">
          {locale === "es" ? "Para iPhone y Apple Watch" : "For iPhone & Apple Watch"}
        </span>
      </div>

      <h1
        class="reveal mt-6 text-display font-semibold text-text-primary"
        style="text-wrap: balance;"
      >
        {headline}
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-text-secondary sm:text-xl">
        {subhead}
      </p>

      <div class="reveal mt-8 flex flex-col items-start gap-3">
        <a
          href={APP_STORE_URL}
          rel="noopener"
          aria-label={ctaCopy.ariaLabel}
          class="group inline-flex items-center gap-3 rounded-pill bg-white text-black font-semibold transition hover:scale-[1.02] active:scale-[0.99] h-16 px-7 text-lg"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="currentColor"
            class="-ml-1 shrink-0"
          >
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          <span class="tracking-tight">{ctaCopy.primary}</span>
        </a>
        <p class="text-sm text-text-secondary">{ctaCopy.secondary}</p>
      </div>
    </div>

    <div class="reveal lg:col-span-5 flex justify-center lg:justify-end">
      <DeviceFrame
        src={heroImage}
        alt={heroImageAlt}
        width={400}
        height={867}
        loading="eager"
        fetchpriority="high"
        class="max-w-[280px] sm:max-w-[340px] lg:max-w-[400px]"
      />
    </div>
  </div>
</Section>
