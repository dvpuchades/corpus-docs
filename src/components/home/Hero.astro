---
import Section from "~/components/Section.astro";
import AppStoreBadge from "~/components/AppStoreBadge.astro";
import DeviceFrame from "~/components/DeviceFrame.astro";
import type { Locale } from "~/i18n/ui";

interface Props {
  locale: Locale;
  headline: string;
  subhead: string;
  heroImage: string;
  heroImageAlt: string;
}
const { locale, headline, subhead, heroImage, heroImageAlt } = Astro.props;
---
<Section as="section" class="pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-16 relative overflow-hidden">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[520px] w-[820px] -translate-x-1/2 rounded-full bg-accent/15 blur-[120px]" />
    <div class="absolute right-[-10%] top-1/3 h-[420px] w-[640px] rounded-full bg-success/[0.06] blur-[120px]" />
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="reveal flex items-center gap-3">
        <img
          src="/images/icon/icon-64.png"
          srcset="/images/icon/icon-64.png 1x, /images/icon/icon-128.png 2x"
          width="56"
          height="56"
          alt="Corpus"
          class="rounded-[14px] ring-1 ring-hairline"
        />
        <span class="rounded-pill bg-bg-1 px-3 py-1 text-xs uppercase tracking-[0.16em] text-text-secondary">
          {locale === "es" ? "Para iPhone y Apple Watch" : "For iPhone & Apple Watch"}
        </span>
      </div>

      <h1
        class="reveal mt-6 text-display font-semibold text-text-primary"
        style="text-wrap: balance;"
      >
        {headline}
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-text-secondary sm:text-xl">
        {subhead}
      </p>

      <div class="reveal mt-8 flex flex-wrap items-center gap-4">
        <AppStoreBadge locale={locale} size="lg" />
        <p class="text-sm text-text-secondary">
          {locale === "es" ? "3,99 €/mes. Lo que cuesta un café en Irlanda, o un desayuno en España." : "€3.99/month. The price of a coffee in Ireland, or a breakfast deal in Spain."}
        </p>
      </div>
    </div>

    <div class="reveal lg:col-span-5 flex justify-center lg:justify-end">
      <DeviceFrame
        src={heroImage}
        alt={heroImageAlt}
        width={400}
        height={867}
        loading="eager"
        fetchpriority="high"
        class="max-w-[280px] sm:max-w-[340px] lg:max-w-[400px]"
      />
    </div>
  </div>
</Section>
