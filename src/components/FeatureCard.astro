---
interface Props {
  title: string;
  body: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  icon?: "spark" | "lock" | "heart";
}
const {
  title,
  body,
  image,
  imageAlt = "",
  imageWidth = 800,
  imageHeight = 1734,
  icon,
} = Astro.props;
---
<article class="reveal flex flex-col gap-5 rounded-card border border-hairline/70 bg-bg-1 p-6 transition hover:border-hairline">
  {image ? (
    <div class="relative -mx-2 -mt-2 mb-1 overflow-hidden rounded-[14px] bg-bg-2">
      <img
        src={image}
        alt={imageAlt}
        width={imageWidth}
        height={imageHeight}
        loading="lazy"
        decoding="async"
        class="block w-full h-auto"
      />
    </div>
  ) : icon ? (
    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-bg-2 text-accent">
      {icon === "lock" && (
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
      )}
      {icon === "heart" && (
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      )}
      {icon === "spark" && (
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
        </svg>
      )}
    </div>
  ) : null}

  <div class="flex flex-1 flex-col">
    <h3 class="text-lg font-semibold text-text-primary tracking-tight">{title}</h3>
    <p class="mt-2 text-text-secondary leading-relaxed">{body}</p>
  </div>
</article>
