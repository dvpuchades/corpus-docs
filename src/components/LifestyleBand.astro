---
interface Photo {
  src: string;
  alt: string;
}

interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;
---
<section aria-label="lifestyle" class="bg-bg-base border-y border-hairline/70 overflow-hidden">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
    {photos.map((p, i) => (
      <figure class="relative aspect-[4/5] overflow-hidden bg-bg-1">
        <img
          src={p.src}
          alt={p.alt}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition duration-700 hover:scale-[1.04]"
          width="600"
          height="750"
        />
      </figure>
    ))}
  </div>
</section>
